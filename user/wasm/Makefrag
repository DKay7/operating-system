# WebAssembly JIT for JOS: builds $(OBJDIR)/user/wasm/wasm.
# Every .c under user/wasm (except tests/, doom/ and helloworld/) is picked up automatically.

WASM_SRCFILES := $(shell find user/wasm \( -path user/wasm/tests -o -path user/wasm/doom -o -path user/wasm/helloworld \) -prune -o -name '*.c' -print)
WASM_OBJFILES := $(patsubst %.c, $(OBJDIR)/%.o, $(WASM_SRCFILES))

OBJDIRS += $(sort $(dir $(WASM_OBJFILES:$(OBJDIR)/%=%)))

# Project headers are included from user/wasm: #include "parser/reader.h".
# This rule has a shorter stem than $(OBJDIR)/user/%.o, so make prefers it.
WASM_INCLUDES := -Iuser/wasm

$(OBJDIR)/user/wasm/%.o: user/wasm/%.c $(OBJDIR)/.vars.USER_CFLAGS
	@echo + cc[USER] $<
	@mkdir -p $(@D)
	$(V)$(CC) $(USER_CFLAGS) $(USER_SAN_CFLAGS) $(WASM_INCLUDES) -c -o $@ $<

$(OBJDIR)/user/wasm/wasm: $(WASM_OBJFILES) $(OBJDIR)/lib/entry.o $(USERLIBS:%=$(OBJDIR)/lib/lib%.a) $(USER_EXTRA_OBJFILES) user/user.ld
	@echo + ld $@
	$(V)$(LD) -o $@ $(ULDFLAGS) $(LDFLAGS) $(USER_SAN_LDFLAGS) -nostdlib $(OBJDIR)/lib/entry.o $(USER_EXTRA_OBJFILES) $(WASM_OBJFILES) -L$(OBJDIR)/lib $(USERLIBS:%=-l%) $(GCC_LIB)
	$(V)$(OBJDUMP) -S $@ > $@.asm
	$(V)$(NM) -n $@ > $@.sym

# Test modules, all of them go to the fs image:
#   tests/*.c    -> clang --target=wasm32 (MVP features only, no libc)
#   tests/*.wat  -> wat2wasm, only if wabt is installed
#   tests/*.wasm -> used as is
WASM_CC ?= clang
WASM_CFLAGS := --target=wasm32 -mcpu=mvp -O2 -nostdlib -Wall \
               -Wl,--no-entry -Wl,--export-all
WAT2WASM ?= wat2wasm

WASM_TESTS := $(wildcard user/wasm/tests/*.wasm) user/wasm/tests/run.sh
WASM_TESTS += $(patsubst user/wasm/tests/%.c, $(OBJDIR)/user/wasm/tests/%.wasm, $(wildcard user/wasm/tests/*.c))
ifneq ($(shell command -v $(WAT2WASM) 2>/dev/null),)
WASM_TESTS += $(patsubst user/wasm/tests/%.wat, $(OBJDIR)/user/wasm/tests/%.wasm, $(wildcard user/wasm/tests/*.wat))
endif

# the same tests with the JIT: wasm -> wasm -j
WASM_TESTS += $(OBJDIR)/user/wasm/tests/run-jit.sh

$(OBJDIR)/user/wasm/tests/run-jit.sh: user/wasm/tests/run.sh
	@mkdir -p $(@D)
	$(V)sed 's/^wasm /wasm -j /' $< > $@

$(OBJDIR)/user/wasm/tests/%.wasm: user/wasm/tests/%.c
	@echo + cc[WASM] $<
	@mkdir -p $(@D)
	$(V)$(WASM_CC) $(WASM_CFLAGS) -o $@ $<

$(OBJDIR)/user/wasm/tests/%.wasm: user/wasm/tests/%.wat
	@echo + wat2wasm $<
	@mkdir -p $(@D)
	$(V)$(WAT2WASM) $< -o $@


# WASI programs, built only after user/wasm/doom/fetch.sh has downloaded
# wasi-libc, compiler builtins, doom-ascii and doom1.wad into doom/third_party/
WASI_TP := user/wasm/doom/third_party
WASI_CFLAGS := --target=wasm32-wasi --sysroot=$(WASI_TP)/wasi-sysroot -mcpu=mvp -O2
WASI_LDFLAGS := -nodefaultlibs -lc $(WASI_TP)/libclang_rt.builtins-wasm32.a \
                -Wl,-z,stack-size=1048576

ifneq ($(wildcard $(WASI_TP)/wasi-sysroot),)
WASM_WASI := $(OBJDIR)/user/wasm/helloworld/hello.wasm \
             $(OBJDIR)/user/wasm/doom/doom.wasm $(WASI_TP)/doom1.wad \
             $(WASI_TP)/doom-ascii/src/.default.cfg
endif

$(OBJDIR)/user/wasm/helloworld/hello.wasm: user/wasm/helloworld/hello.c
	@echo + cc[WASI] $@
	@mkdir -p $(@D)
	$(V)$(WASM_CC) $(WASI_CFLAGS) $^ $(WASI_LDFLAGS) -o $@

DOOM_DIR := user/wasm/doom
DOOM_CFLAGS := $(WASI_CFLAGS) -DNORMALUNIX -DLINUX -I$(DOOM_DIR)/compat -w

$(OBJDIR)/user/wasm/doom/doom.wasm: $(wildcard $(WASI_TP)/doom-ascii/src/*.c) $(DOOM_DIR)/compat/stubs.c
	@echo + cc[WASI] $@
	@mkdir -p $(@D)
	$(V)$(WASM_CC) $(DOOM_CFLAGS) $^ $(WASI_LDFLAGS) -o $@

.PHONY: wasm
wasm: $(OBJDIR)/user/wasm/wasm $(WASM_TESTS) $(WASM_WASI)
