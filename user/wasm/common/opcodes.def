// Opcode DSL: OP_DEF(OP_NAME, byte, name, imm, pops, pushes)

// control
OP_DEF(OP_UNREACHABLE, 0x00, unreachable, none, 0, 0)
OP_DEF(OP_NOP, 0x01, nop, none, 0, 0)
OP_DEF(OP_BLOCK, 0x02, block, blocktype, 0, 0)
OP_DEF(OP_LOOP, 0x03, loop, blocktype, 0, 0)
OP_DEF(OP_IF, 0x04, if, blocktype, 1, 0)
OP_DEF(OP_ELSE, 0x05, else, none, 0, 0)
OP_DEF(OP_END, 0x0B, end, none, 0, 0)
OP_DEF(OP_BR, 0x0C, br, idx, 0, 0)
OP_DEF(OP_BR_IF, 0x0D, br_if, idx, 1, 0)
OP_DEF(OP_BR_TABLE, 0x0E, br_table, br_table, 1, 0)
OP_DEF(OP_RETURN, 0x0F, return, none, 0, 0)
OP_DEF(OP_CALL, 0x10, call, idx, 0, 0)
OP_DEF(OP_CALL_INDIRECT, 0x11, call_indirect, call_indirect, 1, 0)

// parametric
OP_DEF(OP_DROP, 0x1A, drop, none, 1, 0)
OP_DEF(OP_SELECT, 0x1B, select, none, 3, 1)

// variables
OP_DEF(OP_LOCAL_GET, 0x20, local_get, idx, 0, 1)
OP_DEF(OP_LOCAL_SET, 0x21, local_set, idx, 1, 0)
OP_DEF(OP_LOCAL_TEE, 0x22, local_tee, idx, 1, 1)
OP_DEF(OP_GLOBAL_GET, 0x23, global_get, idx, 0, 1)
OP_DEF(OP_GLOBAL_SET, 0x24, global_set, idx, 1, 0)

// memory: all have memarg immediate (align:u32, offset:u32)
OP_DEF(OP_I32_LOAD, 0x28, i32_load, memarg, 1, 1)
OP_DEF(OP_I64_LOAD, 0x29, i64_load, memarg, 1, 1)
OP_DEF(OP_I32_LOAD8_S, 0x2C, i32_load8_s, memarg, 1, 1)
OP_DEF(OP_I32_LOAD8_U, 0x2D, i32_load8_u, memarg, 1, 1)
OP_DEF(OP_I32_LOAD16_S, 0x2E, i32_load16_s, memarg, 1, 1)
OP_DEF(OP_I32_LOAD16_U, 0x2F, i32_load16_u, memarg, 1, 1)
OP_DEF(OP_I64_LOAD8_S, 0x30, i64_load8_s, memarg, 1, 1)
OP_DEF(OP_I64_LOAD8_U, 0x31, i64_load8_u, memarg, 1, 1)
OP_DEF(OP_I64_LOAD16_S, 0x32, i64_load16_s, memarg, 1, 1)
OP_DEF(OP_I64_LOAD16_U, 0x33, i64_load16_u, memarg, 1, 1)
OP_DEF(OP_I64_LOAD32_S, 0x34, i64_load32_s, memarg, 1, 1)
OP_DEF(OP_I64_LOAD32_U, 0x35, i64_load32_u, memarg, 1, 1)
OP_DEF(OP_I32_STORE, 0x36, i32_store, memarg, 2, 0)
OP_DEF(OP_I64_STORE, 0x37, i64_store, memarg, 2, 0)
OP_DEF(OP_I32_STORE8, 0x3A, i32_store8, memarg, 2, 0)
OP_DEF(OP_I32_STORE16, 0x3B, i32_store16, memarg, 2, 0)
OP_DEF(OP_I64_STORE8, 0x3C, i64_store8, memarg, 2, 0)
OP_DEF(OP_I64_STORE16, 0x3D, i64_store16, memarg, 2, 0)
OP_DEF(OP_I64_STORE32, 0x3E, i64_store32, memarg, 2, 0)
OP_DEF(OP_MEMORY_SIZE, 0x3F, memory_size, memidx, 0, 1)
OP_DEF(OP_MEMORY_GROW, 0x40, memory_grow, memidx, 1, 1)

// constants
OP_DEF(OP_I32_CONST, 0x41, i32_const, i32, 0, 1)
OP_DEF(OP_I64_CONST, 0x42, i64_const, i64, 0, 1)

// i32 comparison
OP_DEF(OP_I32_EQZ, 0x45, i32_eqz, none, 1, 1)
OP_DEF(OP_I32_EQ, 0x46, i32_eq, none, 2, 1)
OP_DEF(OP_I32_NE, 0x47, i32_ne, none, 2, 1)
OP_DEF(OP_I32_LT_S, 0x48, i32_lt_s, none, 2, 1)
OP_DEF(OP_I32_LT_U, 0x49, i32_lt_u, none, 2, 1)
OP_DEF(OP_I32_GT_S, 0x4A, i32_gt_s, none, 2, 1)
OP_DEF(OP_I32_GT_U, 0x4B, i32_gt_u, none, 2, 1)
OP_DEF(OP_I32_LE_S, 0x4C, i32_le_s, none, 2, 1)
OP_DEF(OP_I32_LE_U, 0x4D, i32_le_u, none, 2, 1)
OP_DEF(OP_I32_GE_S, 0x4E, i32_ge_s, none, 2, 1)
OP_DEF(OP_I32_GE_U, 0x4F, i32_ge_u, none, 2, 1)

// i64 comparison
OP_DEF(OP_I64_EQZ, 0x50, i64_eqz, none, 1, 1)
OP_DEF(OP_I64_EQ, 0x51, i64_eq, none, 2, 1)
OP_DEF(OP_I64_NE, 0x52, i64_ne, none, 2, 1)
OP_DEF(OP_I64_LT_S, 0x53, i64_lt_s, none, 2, 1)
OP_DEF(OP_I64_LT_U, 0x54, i64_lt_u, none, 2, 1)
OP_DEF(OP_I64_GT_S, 0x55, i64_gt_s, none, 2, 1)
OP_DEF(OP_I64_GT_U, 0x56, i64_gt_u, none, 2, 1)
OP_DEF(OP_I64_LE_S, 0x57, i64_le_s, none, 2, 1)
OP_DEF(OP_I64_LE_U, 0x58, i64_le_u, none, 2, 1)
OP_DEF(OP_I64_GE_S, 0x59, i64_ge_s, none, 2, 1)
OP_DEF(OP_I64_GE_U, 0x5A, i64_ge_u, none, 2, 1)

// i32 arithmetic
OP_DEF(OP_I32_CLZ, 0x67, i32_clz, none, 1, 1)
OP_DEF(OP_I32_CTZ, 0x68, i32_ctz, none, 1, 1)
OP_DEF(OP_I32_POPCNT, 0x69, i32_popcnt, none, 1, 1)
OP_DEF(OP_I32_ADD, 0x6A, i32_add, none, 2, 1)
OP_DEF(OP_I32_SUB, 0x6B, i32_sub, none, 2, 1)
OP_DEF(OP_I32_MUL, 0x6C, i32_mul, none, 2, 1)
OP_DEF(OP_I32_DIV_S, 0x6D, i32_div_s, none, 2, 1)
OP_DEF(OP_I32_DIV_U, 0x6E, i32_div_u, none, 2, 1)
OP_DEF(OP_I32_REM_S, 0x6F, i32_rem_s, none, 2, 1)
OP_DEF(OP_I32_REM_U, 0x70, i32_rem_u, none, 2, 1)
OP_DEF(OP_I32_AND, 0x71, i32_and, none, 2, 1)
OP_DEF(OP_I32_OR, 0x72, i32_or, none, 2, 1)
OP_DEF(OP_I32_XOR, 0x73, i32_xor, none, 2, 1)
OP_DEF(OP_I32_SHL, 0x74, i32_shl, none, 2, 1)
OP_DEF(OP_I32_SHR_S, 0x75, i32_shr_s, none, 2, 1)
OP_DEF(OP_I32_SHR_U, 0x76, i32_shr_u, none, 2, 1)
OP_DEF(OP_I32_ROTL, 0x77, i32_rotl, none, 2, 1)
OP_DEF(OP_I32_ROTR, 0x78, i32_rotr, none, 2, 1)

// i64 arithmetic
OP_DEF(OP_I64_CLZ, 0x79, i64_clz, none, 1, 1)
OP_DEF(OP_I64_CTZ, 0x7A, i64_ctz, none, 1, 1)
OP_DEF(OP_I64_POPCNT, 0x7B, i64_popcnt, none, 1, 1)
OP_DEF(OP_I64_ADD, 0x7C, i64_add, none, 2, 1)
OP_DEF(OP_I64_SUB, 0x7D, i64_sub, none, 2, 1)
OP_DEF(OP_I64_MUL, 0x7E, i64_mul, none, 2, 1)
OP_DEF(OP_I64_DIV_S, 0x7F, i64_div_s, none, 2, 1)
OP_DEF(OP_I64_DIV_U, 0x80, i64_div_u, none, 2, 1)
OP_DEF(OP_I64_REM_S, 0x81, i64_rem_s, none, 2, 1)
OP_DEF(OP_I64_REM_U, 0x82, i64_rem_u, none, 2, 1)
OP_DEF(OP_I64_AND, 0x83, i64_and, none, 2, 1)
OP_DEF(OP_I64_OR, 0x84, i64_or, none, 2, 1)
OP_DEF(OP_I64_XOR, 0x85, i64_xor, none, 2, 1)
OP_DEF(OP_I64_SHL, 0x86, i64_shl, none, 2, 1)
OP_DEF(OP_I64_SHR_S, 0x87, i64_shr_s, none, 2, 1)
OP_DEF(OP_I64_SHR_U, 0x88, i64_shr_u, none, 2, 1)
OP_DEF(OP_I64_ROTL, 0x89, i64_rotl, none, 2, 1)
OP_DEF(OP_I64_ROTR, 0x8A, i64_rotr, none, 2, 1)

// conversions
OP_DEF(OP_I32_WRAP_I64, 0xA7, i32_wrap_i64, none, 1, 1)
OP_DEF(OP_I64_EXTEND_I32_S, 0xAC, i64_extend_i32_s, none, 1, 1)
OP_DEF(OP_I64_EXTEND_I32_U, 0xAD, i64_extend_i32_u, none, 1, 1)
